<Project>
  <!-- Central package management (Orkeon convention), as in the other templates. OrkeonVersion is
       the version of the local feed: the image rewrites it to the version it built from the
       sources (D32); elsewhere, set it to the version given to scripts/build-orkeon-packages.sh. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <OrkeonVersion>1.0.0-rc.4.src.20261005.gfb26364</OrkeonVersion>
  </PropertyGroup>

  <!-- NuGet vulnerability audit, as in the other templates (see OrkeonRunner/Directory.Packages.props). -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAudit Condition="'$(ORKEON_HARNESS_OFFLINE)' == '1'">false</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup Label="Orkeon (local feed, see nuget.config)">
    <!-- The UI-agnostic core of Orkeon Studio (net10.0, no WPF): the catalogue, the card, the run
         target detector and the mount rules the desktop app applies. Not published on any feed:
         build-orkeon-packages.sh packs it from the same checkout as the CLI. -->
    <PackageVersion Include="Orkeon.Studio.Core" Version="$(OrkeonVersion)" />
    <PackageVersion Include="Orkeon.Compliance.Vfs" Version="$(OrkeonVersion)" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Roslyn">
    <!-- The compiler the build runs and the public API analyzer, pinned as in the other templates. -->
    <PackageVersion Include="Microsoft.Net.Compilers.Toolset" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
