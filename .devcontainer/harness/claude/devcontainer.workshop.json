// VS Code configuration of an Orkeon workshop. Open this folder in VS Code and run
// "Dev Containers: Reopen in Container": the folder is mounted on /workspace, where the harness
// is brought in step at each start and Claude Code opens.
// The workshop owns this file: the harness created it once and never changes it again.
//
// - "orkeon-workshop" is the short name of the image on this machine
//   (docker tag ghcr.io/orkeon/orkeon-workshop:latest orkeon-workshop);
//   write "ghcr.io/orkeon/orkeon-workshop:latest" to use the published image directly.
// - Remove "--gpus=all" on a machine without an NVIDIA GPU, or the container will not start.
// - The container gets no Docker access: it builds and runs Orkeon teams, not the SonarQube stack.
// - The image names no local model: name the one to download in "containerEnv"
//   ("OLLAMA_DEFAULT_MODEL": "qwen3:8b", about 5 GB); without it nothing is downloaded and the teams
//   need a model before their first run.
// - A decision model (optional): "KEV_MODE": "host" in "containerEnv" reaches a Kev server of your
//   computer on 127.0.0.1:8009 ("KEV_PORT" for another port, "--add-host=host.docker.internal:host-gateway"
//   in "runArgs" on Linux); a hosted one's key is forwarded by name, never written here:
//   "remoteEnv": { "TYPESAFE_API_KEY": "${localEnv:TYPESAFE_API_KEY}" } (or LIQUID_API_KEY, KEV_API_KEY).
{
  "name": "Orkeon Workshop",
  "image": "orkeon-workshop",
  "runArgs": ["--gpus=all", "--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "init": true,
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "mounts": [
    "source=orkeon-workshop-claude-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=cc-ollama,target=/home/node/.ollama/models,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
    // , "OLLAMA_DEFAULT_MODEL": "qwen3:8b"
    // , "KEV_MODE": "host"
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  },
  "postStartCommand": "/usr/local/bin/init-claude-code.sh; /usr/local/bin/sync-harness.sh; /usr/local/bin/init-orkeon.sh; sudo --preserve-env=FIREWALL_EXTRA_DOMAINS,OLLAMA_MODE,KEV_MODE,KEV_PORT /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
