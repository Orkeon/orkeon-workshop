{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "HARNESS_GUARD_GIT": "0",
    "HARNESS_READ_BOUNDS_LINES": "120",
    "HARNESS_READ_BOUNDS_BYTES": "8000",
    "HARNESS_DIFF_BOUNDS_LINES": "400",
    "HARNESS_REPORT_MAX_LINES": "20",
    "HARNESS_SECRET_GUARD": "1",
    "HARNESS_STATUS_CHECK": "1",
    "HARNESS_RUN_GATE_READ_SETTINGS": "1",
    "HARNESS_TEAM_APPROVE": "1",
    "HARNESS_SESSION_DOCTOR": "1",
    "HARNESS_WORKSHOP_LANGUAGE": "1",
    "HARNESS_MAKE_EXECUTABLE": "1",
    "HARNESS_MEMORY_SCOPE": "1",
    "HARNESS_WORKSHOP_PROFILE": "1",
    "HARNESS_DEV_BATCH_GUARD": "0",
    "HARNESS_PILOT_GUARD": "0",
    "HARNESS_GREP_PATTERNS_MAX": "4",
    "HARNESS_CONTEXT_LOG": "0",
    "HARNESS_CLEAR_NUDGE": "0",
    "HARNESS_DEV_COMPACT": "0",
    "HARNESS_INTEGRATION_PROJECTS": "",
    "HARNESS_INTEGRATION_CATEGORIES": "",
    "HARNESS_SOURCE_CLI_NAMES": "",
    "HARNESS_SOURCE_CLI": "",
    "HARNESS_WORK_DIR": "",
    "HARNESS_DEV_BATCHES_MAX": "2",
    "HARNESS_BUILD_LOCK": "1",
    "HARNESS_AUTO_RESUME": "0",
    "HARNESS_DEV_BATCH_MODEL": "",
    "BASH_DEFAULT_TIMEOUT_MS": "290000",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "HARNESS_WORKTREE_SHARED": "",
    "HARNESS_PR_AUTO": "0",
    "HARNESS_GUARD_RESTORE": "1",
    "HARNESS_SHOW_MEMO": "1",
    "HARNESS_HOOK_RUN": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(**/.git/**)",
      "Edit(/workbooks/*/runs/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" session-cleanup"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" session-doctor"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" workshop-language"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" workshop-profile"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" dev-compact"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "team-approve",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" team-approve",
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" team-approve",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" dev-batch-guard",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" clear-nudge",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" run-gate",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" bash-dispatch",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" delegation-guard",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" clear-nudge",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" read-bounds",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" secret-guard",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" guard-phase",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" memory-scope",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" dev-batch-guard",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" make-executable"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" subagent-report-shape"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" dev-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" status-check"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" worktree-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" worktree-remove"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HARNESS_HOOKS_DIR:-$CLAUDE_PROJECT_DIR/.claude/hooks}/hook-run.sh\" context-log"
          }
        ]
      }
    ]
  }
}
