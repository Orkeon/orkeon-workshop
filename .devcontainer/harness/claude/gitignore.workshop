# The workshop owns this file: the image creates it once as the workshop's .gitignore and
# never touches it again. Edit it freely.

# Raw runs of the bench: large, and reproducible from the team and its datasets
workbooks/*/runs/

# Transient files: the lock orkeon-bench holds while it changes an attempt, and a file
# being written (orkeon-bench and the /team-approve hook write beside the file, then rename)
workbooks/*/attempts/.lock*
**/*.tmp
workbooks/*/.STATUS.*

# The mount sets: the data a team reads and writes in an environment (mails, documents,
# deliverables). The folders of a team's own mount points are kept out by the team's
# .gitignore, which orkeon-bench scaffold writes.
mounts.*/

# Deployment archives (/deploy, orkeon-bench deploy): a team packed for another workshop, reproducible
deployments/

# Dependencies and build output
**/node_modules/
**/bin/
**/obj/
**/obj-linux/

# State the image and the harness keep in the workshop
.claude/harness-backup/
.claude/.harness-initialized
.claude/.harness-manifest
.claude/settings.local.json
.claude/run-log.tsv
.claude/evals/.fixtures/

# Environment files, at any depth: keys never go to git
.env
