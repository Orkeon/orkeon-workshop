      "id": "german",
      "type": "file-exists",
      "path": "/output/drafts/edge-10.txt"
    },
    {
      "id": "german-words",
      "type": "text-absent",
      "path": "/output/drafts/edge-10.txt",
      "pattern": "\\b(Guten|Rechnung|Konto|bitte)\\b"
