{
  "schema_version": "1.0",
  "id": "ac-12-edge-shapes",
  "title": "Every .eml file at the top of the mailbox has one record whatever its shape; the rest is ignored",
  "covers": [
    "AC-08",
    "AC-09",
    "AC-12",
    "AC-13",
    "AC-14"
  ],
  "level": "e2e_local",
  "dataset": "edge",
  "bindings": {
    "/registry": null,
    "/output": null
  },
  "checks": [
    {
      "id": "r01a",
      "type": "text-present",
      "path": "/output/classification.json",
      "pattern": "\"file\":\\s*\"edge\\-01\\.eml\""
    },
    {
      "id": "r01b",
      "type": "text-absent",
      "path": "/output/classification.json",
      "pattern": "\"file\":\\s*\"edge\\-01\\.eml\"[\\s\\S]*\"file\":\\s*\"edge\\-01\\.eml\""
    },
    {
