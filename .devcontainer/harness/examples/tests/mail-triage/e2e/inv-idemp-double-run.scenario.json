{
  "schema_version": "1.0",
  "id": "inv-idemp-double-run",
  "title": "Twice on an unchanged mailbox: the second run adds no record and writes no draft",
  "covers": [
    "INV-IDEMP"
  ],
  "level": "e2e_local",
  "sequence": [
    {
      "dataset": "incr-v1",
      "keep_state": true
    },
    {
      "dataset": "incr-v1",
      "keep_state": true
    }
  ],
  "bindings": {
    "/registry": null,
    "/output": null
  },
  "checks": [
    {
      "id": "r01a",
      "type": "text-present",
      "path": "/output/classification.json",
      "pattern": "\"file\":\\s*\"export\\-01\\.eml\""
    },
    {
      "id": "r01b",
      "type": "text-absent",
      "path": "/output/classification.json",
      "pattern": "\"file\":\\s*\"export\\-01\\.eml\"[\\s\\S]*\"file\":\\s*\"export\\-01\\.eml\""
    },
    {
      "id": "r02a",
      "type": "text-present",
