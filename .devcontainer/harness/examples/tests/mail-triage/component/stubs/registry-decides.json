                "path": "/mailbox"
              }
            },
            {
              "name": "glob",
              "arguments": {
                "pattern": "registry.json",
                "path": "/registry"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "file_read",
              "arguments": {
                "path": "/registry/registry.json"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "file_write",
              "arguments": {
                "path": "/registry/pending.json",
