            {
              "name": "file_read",
              "arguments": {
                "path": "/registry/registry.json"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "file_write",
              "arguments": {
                "path": "/registry/registry.json",
                "content": "[\n  \"export-01.eml\",\n  \"export-02.eml\",\n  \"export-03.eml\",\n  \"export-04.eml\",\n  \"export-05.eml\",\n  \"export-06.eml\"\n]"
              }
            }
          ]
        },
        {
          "content": "The registry holds 6 file names."
        }
      ]
    },
    {
      "match": {
        "role": "Mail sorter",
        "task": "Classify the pending mails"
      },
      "turns": [
        {
          "tool_calls": [
            {
              "name": "file_read",
              "arguments": {
                "path": "/registry/pending.json"
              }
            }
          ]
        },
        {
          "content": "[]"
        }
      ]
    },
    {
      "match": {
        "role": "Reply drafter"
