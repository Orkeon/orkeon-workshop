{
  "fixtures": {},
  "cases": [
    {
      "name": "off by default: the image's orkeon runs when no repository pack set the switch",
      "hook": "hooks/bash-dispatch.sh",
      "input": {
        "tool_name": "Bash",
        "session_id": "{{SID}}",
        "agent_id": "",
        "transcript_path": "",
        "tool_input": {
          "command": "orkeon run teams/demo/crew"
        }
      },
      "expect": {
        "decision": "not_deny"
      }
    },
    {
      "name": "Orkeon checkout: `orkeon run` is refused",
      "hook": "hooks/bash-dispatch.sh",
      "env": {
        "HARNESS_SOURCE_CLI_NAMES": "orkeon",
        "HARNESS_SOURCE_CLI": "dotnet run --project src/scripting/Orkeon.Scripting.Cli --"
      },
      "input": {
        "tool_name": "Bash",
        "session_id": "{{SID}}",
        "agent_id": "",
        "transcript_path": "",
        "tool_input": {
          "command": "orkeon run teams/demo/crew"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "guard-source-cli: the image's `orkeon` refused in a source checkout"
      }
    },
    {
      "name": "the refusal quotes the checkout's command with the refused arguments behind it",
      "hook": "hooks/bash-dispatch.sh",
      "env": {
        "HARNESS_SOURCE_CLI_NAMES": "orkeon",
        "HARNESS_SOURCE_CLI": "dotnet run --project src/scripting/Orkeon.Scripting.Cli --"
