{
  "cases": [
    {
      "name": "an sk- key written under teams/ is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/README.md",
          "content": "export ANTHROPIC_API_KEY=sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "secret-guard: refusing to write what looks like a secret"
      }
    },
    {
      "name": "the scope is matched without regard to case (Windows bind mount)",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/Teams/alpha/README.md",
          "content": "token: ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "GitHub token"
      }
    },
    {
      "name": "the deny never echoes the secret",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/README.md",
          "content": "key: sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "deny",
        "stdout_absent": "abcdefghijklmnopqrstuvwxyz0123456789"
      }
    },
    {
      "name": "an ORKEON_Llm__ApiKey assignment in an Edit under library/ is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Edit",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/library/tools/ts/scoring/README.md",
          "old_string": "x",
          "new_string": "ORKEON_Llm__ApiKey=zz9f8e7d6c5b4a3920\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "Orkeon LLM key assignment"
      }
    },
    {
      "name": "an ORKEON_Llm__ApiKey placeholder passes",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Edit",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/library/tools/ts/scoring/README.md",
          "old_string": "x",
          "new_string": "ORKEON_Llm__ApiKey=<your key, never on disk>\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "a keyEnv naming the variable passes (the convention of bench.config.json)",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/tests/alpha/bench.config.json",
          "content": "{\"profiles\": {\"claude\": {\"keyEnv\": \"ANTHROPIC_API_KEY\", \"apiKey\": \"ORKEON_TAVILY_API_KEY\"}}}\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "normal prose passes",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/workbooks/alpha/NEED.md",
          "content": "# Mail triage — Need\n\n## Purpose\nClassify incoming .eml files and draft replies. The token budget is 50k per run.\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "a private key block under references/ is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/references/local/notes.md",
          "content": "-----BEGIN RSA PRIVATE KEY-----\nMIIE\n-----END RSA PRIVATE KEY-----\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "private key block"
      }
    },
    {
      "name": "a GitHub token is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/mounts.json",
          "content": "{\"token\": \"ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\"}"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "GitHub token"
      }
    },
    {
      "name": "a key in a team's settings file is denied: settings/ is in the default scope (D33)",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/settings/alpha/appsettings.json",
          "content": "{\"Llm\": {\"BaseUrl\": \"https://api.openai.com/v1\", \"ApiKey\": \"sk-proj-ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcd\"}}"
        }
      },
      "expect": {
        "decision": "deny"
      }
    },
    {
      "name": "a password written JSON-style is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/crew/settings.json",
          "content": "{\"password\": \"S3cr3tValue1234567890abcd\"}\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "generic credential assignment"
      }
    },
    {
      "name": "a prefixed key name (client_secret) is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/README.md",
          "content": "client_secret: S3cr3tValue1234567890abcd\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "generic credential assignment"
      }
    },
    {
      "name": "a value that is plainly a file path is not a credential",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/tests/alpha/e2e/ac-01-nominal.scenario.json",
          "content": "{\"token\": \"tests/judges/quality-rubric-v2.md\", \"secret\": \"tests/datasets/nominal/expected/result.json\"}\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "a token count is not a credential",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/workbooks/alpha/NEED.md",
          "content": "max_tokens: 12000\ntokens: 1234567890123456789012\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "the same key outside the folders of the scope is out of scope",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/tmp/scratch/notes.md",
          "content": "sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "a key written into the workbook of a team (workbooks/<slug>/) is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/workbooks/alpha/DESIGN.md",
          "content": "export ANTHROPIC_API_KEY=sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "secret-guard: refusing to write what looks like a secret"
      }
    },
    {
      "name": "a key written into the tests of a team (tests/<slug>/) is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/tests/alpha/datasets/nominal/workspace/mail.eml",
          "content": "export ANTHROPIC_API_KEY=sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "secret-guard: refusing to write what looks like a secret"
      }
    },
    {
      "name": "a key written into a mount set (mounts.<name>/) is denied",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/mounts.test/alpha/mailbox/1.eml",
          "content": "export ANTHROPIC_API_KEY=sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "secret-guard: refusing to write what looks like a secret"
      }
    },
    {
      "name": "a folder that only starts like a mount set is out of scope",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/mountsx/alpha/notes.md",
          "content": "export ANTHROPIC_API_KEY=sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "HARNESS_SECRET_GUARD=0 disables the guard",
      "hook": "hooks/secret-guard.sh",
      "env": {
        "HARNESS_SECRET_GUARD": "0"
      },
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/README.md",
          "content": "sk-ant-api03-abcdefghijklmnopqrstuvwxyz0123456789\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "HARNESS_SECRET_ALLOW lifts one pattern for a false positive",
      "hook": "hooks/secret-guard.sh",
      "env": {
        "HARNESS_SECRET_ALLOW": "^sk-example-"
      },
      "input": {
        "tool_name": "Write",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/README.md",
          "content": "sk-example-0123456789abcdefghij\n"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "a Read tool payload is ignored",
      "hook": "hooks/secret-guard.sh",
      "input": {
        "tool_name": "Read",
        "session_id": "{{SID}}",
        "tool_input": {
          "file_path": "/workspace/teams/alpha/README.md"
        }
      },
      "expect": {
        "decision": "none"
      }
    },
    {
      "name": "an empty payload is a no-op",
      "hook": "hooks/secret-guard.sh",
      "input": {},
      "expect": {
        "exit": 0,
        "decision": "none"
      }
    }
  ]
}
