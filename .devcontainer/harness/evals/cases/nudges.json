      "name": "batching: a subagent with a run of mono-call turns in its own transcript: the nudge, its state suffixed with the agent",
      "cmd": "D={{CLAUDE}}/hooks/bash-dispatch.sh; S={{FIX}}/{{SID}}/subagents; mkdir -p $S; run() { o=$(jq -n --arg a \"$1\" --arg y \"$2\" --arg t \"${3:-{{FIX}}/main-{{SID}}.jsonl}\" '{hook_event_name: \"PreToolUse\", session_id: \"{{SID}}\", tool_name: \"Bash\", agent_id: $a, agent_type: $y, transcript_path: $t, tool_input: {command: \"true\"}}' | bash $D | jq -r '.hookSpecificOutput.additionalContext // empty' | grep -o 'so far [a-z ]*)'); printf '%s ' \"${o:-silent}\"; }; cp {{FIX}}/t-agent-mono.jsonl $S/agent-a1.jsonl; r=$(HARNESS_BATCHING_SAMPLE=1 run a1 dev-implementer); [ \"$r\" = 'so far in this agent) ' ] || printf 'BAD-run:%s ' \"$r\"; [ \"$(cat /tmp/claude-batching-nudge-{{SID}}-a1 2>/dev/null)\" = 6 ] || printf 'BAD-agent-state '; [ -e /tmp/claude-batching-tick-{{SID}}-a1 ] || printf 'BAD-agent-tick '; [ -e /tmp/claude-batching-nudge-{{SID}} ] || [ -e /tmp/claude-batching-tick-{{SID}} ] && printf 'BAD-main-state '; printf 'ok'",
      "expect": {
        "exit": 0,
        "stdout": "ok",
        "stdout_absent": "BAD"
      }
    },
