      "name": "an Agent call without a description is denied",
      "hook": "hooks/delegation-guard.sh",
      "input": {
        "tool_name": "Agent",
        "session_id": "{{SID}}",
        "agent_id": "",
        "tool_input": {
          "subagent_type": "Explore",
          "prompt": "find the scenarios",
          "model": "haiku"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "every Agent call carries a description"
      }
    },
