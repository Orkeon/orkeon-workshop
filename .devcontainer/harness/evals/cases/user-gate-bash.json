{
  "cases": [
    {
      "name": "sed -i on gate_passed in a STATUS.md is denied: a refusal of the Edit tool is not worked around through the shell (D36)",
      "hook": "hooks/bash-dispatch.sh",
      "input": {
        "tool_name": "Bash",
        "session_id": "{{SID}}",
        "tool_input": {
          "command": "sed -i 's/^gate_passed: .*/gate_passed: need/' workbooks/alpha/STATUS.md"
        }
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": "guard-user-gate: this command writes `gate_passed` into a STATUS.md through the shell"
      }
    },
    {
      "name": "the refusal names the line the user types",
      "hook": "hooks/bash-dispatch.sh",
      "input": {
        "tool_name": "Bash",
        "session_id": "{{SID}}",
        "tool_input": {
          "command": "sed -i 's/^gate_passed: .*/gate_passed: need/' workbooks/alpha/STATUS.md"
        }
      },
      "expect": {
        "decision": "deny",
        "reason": "from the line the user types — /team-approve need, test-plan or design — never by Claude (D36)"
      }
    },
    {
